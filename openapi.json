perties":{"dailyForecasts":{"type":"array","description":"날짜별 예보 목록","items":{"$ref":"#/components/schemas/DailyForecast"}}},"description":"별 관측 예보 응답 DTO"},"AstronomyInfo":{"type":"object","properties":{"moonPhase":{"type":"string","description":"달 위상","example":"초승달"},"sunrise":{"type":"string","description":"일출 시간","example":"07:00"},"sunset":{"type":"string","description":"일몰 시간","example":"18:00"},"moonrise":{"type":"string","description":"월출 시간","example":"08:00"},"moonset":{"type":"string","description":"월몰 시간","example":"20:00"}},"description":"천문 정보"},"LightPollutionInfo":{"type":"object","properties":{"bortleClass":{"type":"string","description":"보틀 등급 클래스","example":"Class 3"},"brightness":{"type":"string","description":"밝기 수준","example":"낮음"},"limitingMag":{"type":"string","description":"한계 등급","example":"6등급"}},"description":"광해 정보"},"StargazingAnalyzeResponse":{"type":"object","properties":{"date":{"type":"string","description":"관측 날짜","example":"2025-12-19"},"time":{"type":"string","description":"관측 시간","example":"22:00"},"totalScore":{"type":"integer","description":"종합 점수 (0-100)","format":"int32","example":85},"reasons":{"type":"array","description":"점수 감점 사유 목록","example":["구름량이 많음","습도가 높음"],"items":{"type":"string","description":"점수 감점 사유 목록","example":"[\"구름량이 많음\",\"습도가 높음\"]"}},"aiComment":{"type":"string","description":"AI 한줄 평","example":"오늘 밤 별 관측하기 좋은 날씨입니다!"},"weather":{"$ref":"#/components/schemas/WeatherInfo"},"astronomy":{"$ref":"#/components/schemas/AstronomyInfo"},"lightPollution":{"$ref":"#/components/schemas/LightPollutionInfo"}},"description":"별 관측 조건 분석 응답 DTO"},"WeatherInfo":{"type":"object","properties":{"cloudIndex":{"type":"integer","description":"구름량 (%)","format":"int32","example":20},"humidityIndex":{"type":"integer","description":"습도 (%)","format":"int32","example":60},"visibilityText":{"type":"string","description":"가시도 등급","example":"매우 좋음"}},"description":"기상 정보"}},"securitySchemes":{"bearer-jwt":{"type":"http","name":